{
  "name": "yunagi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "check": "pnpm run check:rust && pnpm run check:types && pnpm run check:web",
    "check:rust": "cargo test -p yunagi-core -p yunagi-cli --locked",
    "check:app": "cargo build -p yunagi-app --locked",
    "check:types": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js --fail-on-warnings && tsc -p tsconfig.node.json",
    "check:web": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "svelte-check": "4.7.7",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
